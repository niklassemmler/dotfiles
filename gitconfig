[user]
  email = niklas@langfuse.com
  name = Niklas Semmler
  editor = vim
[push]
  default = simple
  autoSetupRemote = true
[pull]
  rebase = true
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true    # use n and N to move between diff sections
  light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
  line-numbers = true
  side-by-side = false
[diff]
  # tool = vimdiff
  tool = nvimdiff
[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[merge]
  tool = vimdiff
  conflictstyle = diff3
[mergetool]
  keepBackup = false
[credential]
  helper = cache --timeout=360000
[init]
  defaultBranch = main
[log]
  abbrevCommit = true
[alias]
  addunmerged = "!f() { git add $(git diff --name-only --diff-filter=U --relative); }; f"
  amend = commit --amend
  branchlocal = "!f() { git branch --format '%(refname:short) %(upstream)' | awk '{if (!$2) print $1;}'; }; f"
  cached = diff --cached
  change-commits = "!f() { VAR=$1; OLD=$2; NEW=$3; shift 3; git filter-branch --env-filter \"if [[ \\\"$`echo $VAR`\\\" = '$OLD' ]]; then export $VAR='$NEW'; fi\" $@; }; f"
  ci = commit
  conflict = "!f() { nvim $(git diff --name-only --diff-filter=U --relative); }; f"
  cp = cherry-pick
  fetchall = "!f() { git fetch origin main:main; git fetch --tags --all --force; }; f"
  fetchpr = "!sh -c 'if [ $# -ne 2 ]; then echo \"<pr> <branch>\"; return; fi; PR=$1; BRANCH=$2; git fetch upstream pull/$PR/head:$BRANCH; git checkout $BRANCH;' -"
  files = log --name-only
  getmaster = "!f() { git checkout master && git fetch upstream master && git rebase upstream/master; }; f"
  hist = log --pretty=oneline --abbrev-commit --graph --decorate --all
  history = log --pretty=oneline --abbrev-commit --graph --decorate --all
  last = log -1 HEAD -p
  lastbranch = "!f() { git reflog | grep -o \"checkout: moving from .* to \" | sed -e 's/checkout: moving from //' -e 's/ to $//' | awk '!x[$0]++' | head -10; }; f"
  pushnew = "!f() { git push --set-upstream origin $(git branch --show-current); }; f"
  rabort = "rebase --abort"
  rbab = rebase --abort
  rbco = rebase --continue
  rbi = "!f() { git rebase -i $(git log --invert-grep --author='Niklas Semmler' -1 --pretty="%H"); }; f"
  rbmain = rebase main
  rcont = "rebase --continue"
  rst = reset
  rsthd = reset HEAD~
  stat = status -s
  sw = "switch"
  unmerged = "!f() { git diff --name-only --diff-filter=U --relative; }; f"
  unpushed = log --branches --not --remotes --no-walk --decorate --oneline
  visual = ! gitk &
  current = symbolic-ref --short HEAD
